{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mumai-assistant",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-09",
  "secrets": { "required": ["OPENAI_API_KEY"] },
  "vars": {
    "ALLOWED_ORIGINS": "https://mohamed-elrady.github.io",
    "OPENAI_MODEL": "gpt-5-mini"
  }
}
